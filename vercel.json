{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "uploads": {
      "root": "cloud_upload",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "UPLOADS_BACKEND_URL"
        }
      ]
    },
    "mcp": {
      "root": "mcp_gateway",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "MCP_BACKEND_URL"
        }
      ]
    },
    "worker": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.worker",
      "functions": {
        "**": {
          "maxDuration": 300,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "pcap-analysis",
              "maxDeliveries": 3,
              "retryAfterSeconds": 30,
              "maxConcurrency": 1
            }
          ]
        }
      }
    },
    "tlsworker": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.worker",
      "functions": {
        "**": {
          "maxDuration": 300,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "pcap-tls-decryption",
              "maxDeliveries": 3,
              "retryAfterSeconds": 30,
              "maxConcurrency": 1
            }
          ]
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/api/cloud/upload-token",
      "destination": {
        "service": "uploads"
      }
    },
    {
      "source": "/cloud-assets/:path*",
      "destination": {
        "service": "uploads"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/identity/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
