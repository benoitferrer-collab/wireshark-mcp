# Copy to deploy/.env, which is ignored by git. No production credentials here.
PCAP_DOMAIN=pcap.example.com
ACME_EMAIL=admin@example.com
API_ACCESS_TOKEN=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["https://your-interface.vercel.app"]

# External OAuth provider: authorization code + PKCE S256, refresh tokens,
# RS256 access tokens, API audience below and permission pcap:read.
MCP_OAUTH_ISSUER=https://your-tenant.example.com/
MCP_OAUTH_AUDIENCE=https://pcap.example.com/mcp
MCP_OAUTH_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# Exact sub claim of your personal account (not email). Comma separated if needed.
MCP_ALLOWED_SUBJECTS=replace-with-your-oauth-subject

# Microsoft Entra alternative: see docs/ENTRA_MCP.md. Use the API's client ID
# for MCP_OAUTH_AUDIENCE and user object IDs (oid) for MCP_ALLOWED_SUBJECTS.
# MCP_OAUTH_PROVIDER=entra
# MCP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# MCP_OAUTH_ISSUER=https://login.microsoftonline.com/TENANT_ID/v2.0
# MCP_OAUTH_JWKS_URL=https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys
