# Copier ce fichier vers .env et renseigner les valeurs.
# .env est ignoré par git : ne jamais committer de clés réelles.

# ====================================
# Configuration Générale
# ====================================
LOG_LEVEL=INFO
DEBUG=false
MAX_FILE_SIZE=3221225472
ANALYSIS_TIMEOUT=3600
WORKERS=5

# ====================================
# Configuration Ollama (IA)
# ====================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# ====================================
# Threat Intelligence (optionnel)
# ====================================
# CROWDSEC_API_KEY=votre-cle-crowdsec
# ABUSEIPDB_API_KEY=votre-cle-abuseipdb

# ====================================
# Protection des endpoints de configuration
# ====================================
# Si défini, les POST /api/ai/config et /api/maclookup/config exigent
# le header X-Admin-Token avec cette valeur (sinon: loopback uniquement)
# CONFIG_API_TOKEN=un-token-long-et-aleatoire
